<?xml version="1.0"?>
<robot name="turtlebot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find turtlebot2_description)/urdf/turtlebot2.gazebo.xacro"/>

  <!-- Kobuki dimensions -->
  <xacro:property name="base_radius"   value="0.175"/>
  <xacro:property name="base_height"   value="0.065"/>
  <xacro:property name="wheel_radius"  value="0.035"/>
  <xacro:property name="wheel_width"   value="0.025"/>
  <xacro:property name="wheel_sep"     value="0.230"/>
  <xacro:property name="caster_radius" value="0.018"/>
  <!-- Laser mounted 0.13m above base_link centre -->
  <xacro:property name="laser_z"       value="0.130"/>

  <!-- ════════════════════════════════════════════
       base_footprint  (root, ground-projected frame)
       ════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child  link="base_link"/>
  </joint>

  <!-- ════════════════
       Chassis (cylinder)
       ════════════════ -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="kobuki_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.4"/>
      <origin xyz="0 0 0"/>
      <!-- I = m*r^2/2 for z, m*(3r^2+h^2)/12 for x/y -->
      <inertia ixx="0.019995" ixy="0" ixz="0"
               iyy="0.019995" iyz="0"
               izz="0.036750"/>
    </inertial>
  </link>

  <!-- ════════════
       Left wheel
       ════════════ -->
  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="0 ${wheel_sep/2} 0" rpy="${-pi/2} 0 0"/>
    <parent link="base_link"/>
    <child  link="wheel_left_link"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="kobuki_wheel"><color rgba="0.25 0.25 0.25 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ═════════════
       Right wheel
       ═════════════ -->
  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="0 ${-wheel_sep/2} 0" rpy="${pi/2} 0 0"/>
    <parent link="base_link"/>
    <child  link="wheel_right_link"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="kobuki_wheel"><color rgba="0.25 0.25 0.25 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- ═════════════════
       Front caster ball
       ═════════════════ -->
  <joint name="caster_front_joint" type="fixed">
    <origin xyz="0.115 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="caster_front_link"/>
  </joint>
  <link name="caster_front_link">
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ════════════════
       Back caster ball
       ════════════════ -->
  <joint name="caster_back_joint" type="fixed">
    <origin xyz="-0.135 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="caster_back_link"/>
  </joint>
  <link name="caster_back_link">
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════
       Hokuyo LiDAR mount
       (frame name "laser" matches racecar convention → /scan compatible)
       ══════════════════════════════ -->
  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 ${laser_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="laser"/>
  </joint>
  <link name="laser">
    <visual>
      <geometry><box size="0.05 0.05 0.07"/></geometry>
      <material name="hokuyo_body"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

</robot>
