<?xml version="1.0"?>
<!--
  Navigation with map_server (static map) + AMCL localization.
  AMCL reads the map from map_server and the odom→base_link TF from
  gazebo_odometry_odom.py, then publishes map→odom.

  Usage (two terminals):
    Terminal 1: roslaunch racecar_gazebo racecar.launch
    Terminal 2: roslaunch racecar_gazebo racecar_navigation_amcl.launch
-->
<launch>
  <arg name="map_name" default="map_runway" />

  <param name="/use_sim_time" value="true"/>

  <!-- Static map -->
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(find racecar_gazebo)/map/$(arg map_name).yaml" />

  <!-- odom→base_link TF (AMCL will provide map→odom) -->
  <node pkg="racecar_gazebo" name="gazebo_odometry_node" type="gazebo_odometry_odom.py"/>

  <!-- AMCL: reads /map + odom→base_link TF, publishes map→odom TF -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen" respawn="true">
    <rosparam file="$(find racecar_gazebo)/config/amcl_params.yaml" command="load"/>
    <!-- override frame ids (amcl_params.yaml uses base_footprint for turtlebot) -->
    <param name="base_frame_id"   value="base_link"/>
    <param name="odom_frame_id"   value="odom"/>
    <param name="global_frame_id" value="map"/>
    <!-- initial pose matches racecar_amcl.launch spawn position -->
    <param name="initial_pose_x"  value="-5.388334"/>
    <param name="initial_pose_y"  value="-4.094883"/>
    <param name="initial_pose_a"  value="0.0"/>
    <!-- transform tolerance for simulation -->
    <param name="transform_tolerance" value="1.0"/>
  </node>

  <!-- move_base with TEB local planner -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find racecar_gazebo)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find racecar_gazebo)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find racecar_gazebo)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find racecar_gazebo)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find racecar_gazebo)/config/teb_local_planner_params.yaml" command="load" />

    <param name="base_global_planner"   value="global_planner/GlobalPlanner" />
    <param name="planner_frequency"     value="0.01" />
    <param name="planner_patience"      value="5.0" />

    <param name="base_local_planner"    value="teb_local_planner/TebLocalPlannerROS" />
    <param name="controller_frequency"  value="5.0" />
    <param name="controller_patience"   value="15.0" />

    <param name="clearing_rotation_allowed" value="false" />
  </node>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find racecar_gazebo)/config/racecar_rviz.rviz"/>

</launch>
