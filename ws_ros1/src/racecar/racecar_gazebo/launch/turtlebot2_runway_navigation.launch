<?xml version="1.0"?>
<!--
  Turtlebot2 A→B navigation with pre-built map.
  Loads map_runway, runs AMCL for localisation, move_base with DWA, opens RViz.

  Usage (two terminals):
    Terminal 1: roslaunch racecar_gazebo turtlebot2_runway.launch
    Terminal 2: roslaunch racecar_gazebo turtlebot2_runway_navigation.launch
  Then use RViz "2D Nav Goal" to send a target.
-->
<launch>

  <param name="/use_sim_time" value="true"/>

  <!-- Load pre-built map -->
  <node name="map_server" pkg="map_server" type="map_server"
        args="$(find racecar_gazebo)/map/map_runway.yaml"/>

  <!-- AMCL localisation -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_amcl_params.yaml" command="load"/>
  </node>

  <!-- move_base with DWA -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen" respawn="false">
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find racecar_gazebo)/config/turtlebot2_dwa_local_planner_params.yaml"
              command="load"/>

    <param name="base_global_planner"  value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner"   value="dwa_local_planner/DWAPlannerROS"/>
    <param name="planner_frequency"    value="1.0"/>
    <param name="planner_patience"     value="5.0"/>
    <param name="controller_frequency" value="10.0"/>
    <param name="controller_patience"  value="15.0"/>
    <param name="clearing_rotation_allowed" value="true"/>
    <param name="recovery_behavior_enabled" value="true"/>
  </node>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find racecar_gazebo)/config/turtlebot2_navigation.rviz"/>

</launch>
